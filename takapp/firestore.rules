rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─────────────── HELPERS ───────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userRole() {
      return isSignedIn() && userDoc().data.role != null
        ? userDoc().data.role
        : '';
    }
    function userEstablishmentId() {
      return isSignedIn() && userDoc().data.establishmentId != null
        ? userDoc().data.establishmentId
        : '';
    }
    function hasAnyRole(roles) {
      return isSignedIn() && userRole() in roles;
    }
    function canChangeProfileRole(roles) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'updatedAt']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role']) ||
          request.resource.data.role in roles
        );
    }
    function isSuperAdmin() {
      return userRole() == 'super_admin' || userRole() == 'global_admin';
    }
    function isAdminOrOwner() {
      return hasAnyRole(['proprietaire', 'super_admin', 'global_admin']);
    }
    function isGerante() {
      return userRole() == 'gerante';
    }
    function isServeur() {
      return userRole() == 'serveur';
    }
    function isChefCuisine() {
      return userRole() == 'chef_cuisine';
    }
    function isBarman() {
      return userRole() == 'barman';
    }
    function isServiceHygiene() {
      return hasAnyRole(['service_hygiene', 'hygiene', 'majordhomme']);
    }
    function isAccounting() {
      return userRole() == 'comptable';
    }
    function isReceptionniste() {
      return userRole() == 'receptionniste';
    }
    function isFloorManager() {
      return userRole() == 'floor_manager';
    }
    // Lecture « tout membre du tenant » des sous-collections.
    //
    // floor_manager en est exclu : rôle introduit sans fonction métier, il ne
    // lit que son profil et le document établissement. Chaque accès futur
    // (services, serveurs, commandes…) devra être ouvert par une règle
    // explicite, jamais hérité de ce filet.
    function tenantReader(establishmentId) {
      return sameEstablishment(establishmentId) && !isFloorManager();
    }

    // ─────────────── SERVICES (SHIFTS) : helpers ───────────────
    // Créer / ouvrir / clôturer un service et y affecter des serveurs.
    // Le Floor Manager n'en fait PAS partie.
    function isShiftManager() {
      return isGerante() || isAdminOrOwner();
    }
    function shiftDoc(establishmentId, shiftId) {
      return /databases/$(database)/documents/establishments/$(establishmentId)/shifts/$(shiftId);
    }
    function fmPointerDoc(establishmentId, floorManagerId) {
      return /databases/$(database)/documents/establishments/$(establishmentId)/floorManagerCurrentShift/$(floorManagerId);
    }
    function serverPointerDoc(establishmentId, serverId) {
      return /databases/$(database)/documents/establishments/$(establishmentId)/serverCurrentShift/$(serverId);
    }
    // Compte existant, actif, du rôle attendu, dans CET établissement.
    function isEstablishmentUser(uid, establishmentId, role) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.get('role', '') == role &&
        u.get('establishmentId', '') == establishmentId &&
        u.get('isActive', true) != false;
    }
    function unchangedFields(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    function validShiftData(establishmentId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'establishmentId', 'floorManagerId', 'floorManagerName',
          'startsAt', 'endsAt', 'status', 'serverIds',
          'createdAt', 'createdBy', 'updatedAt',
          'openedAt', 'openedBy', 'closedAt', 'closedBy',
          'createdByName', 'createdByRole',
          'financialStatus', 'financialRevision', 'financialClosedAt',
          'financialClosedBy', 'financialClosedByName', 'financialSummary',
          'cashReceiverId', 'cashReceiverName', 'cashReceiverRole'
        ]) &&
        d.establishmentId == establishmentId &&
        d.status in ['planned', 'open', 'closed'] &&
        d.startsAt is timestamp && d.endsAt is timestamp &&
        d.endsAt > d.startsAt &&
        d.serverIds is list && d.serverIds.size() <= 12 &&
        !(d.floorManagerId in d.serverIds);
    }
    // ─────────────── SERVICE GÉRÉ PAR SON FLOOR MANAGER (14A) ───────────────
    // Destinataire des remises d'un service : gérante ou propriétaire ACTIF
    // de l'établissement (absent : le créateur, comme avant 14A).
    function validCashReceiver(establishmentId) {
      let d = request.resource.data;
      return !('cashReceiverId' in d) || (
        d.cashReceiverRole in ['gerante', 'proprietaire'] &&
        isEstablishmentUser(d.cashReceiverId, establishmentId, d.cashReceiverRole) &&
        d.cashReceiverName is string
      );
    }
    // Le Floor Manager gère SON service, tant qu'il n'est pas terminé :
    // horaires seulement avant l'ouverture ; jamais de réouverture.
    function fmManagesOwnShift() {
      return isFloorManager() &&
        resource.data.floorManagerId == request.auth.uid &&
        resource.data.status != 'closed' &&
        (
          resource.data.status == 'planned' ||
          unchangedFields(['startsAt', 'endsAt'])
        );
    }

    // Floor Manager actif de cet établissement : exigé pour créer, ouvrir ou
    // modifier un service, PAS pour le clôturer (un compte désactivé ne doit
    // pas empêcher la clôture).
    function validShiftFloorManager(establishmentId) {
      return request.resource.data.status == 'closed' ||
        isEstablishmentUser(request.resource.data.floorManagerId, establishmentId, 'floor_manager');
    }
    // planned -> open | closed ; open -> closed ; closed -> open (réouverture
    // explicite). Un service clôturé n'est plus modifiable autrement.
    // Ouvrir exige que le pointeur du Floor Manager désigne CE service dans le
    // même lot : c'est ce qui interdit deux services ouverts simultanés.
    function validShiftTransition(establishmentId, shiftId) {
      let before = resource.data.status;
      let after = request.resource.data.status;
      let sameServers = request.resource.data.serverIds == resource.data.serverIds;
      return (before == after && before != 'closed') ||
        (
          after == 'open' && before in ['planned', 'closed'] && sameServers &&
          existsAfter(fmPointerDoc(establishmentId, request.resource.data.floorManagerId)) &&
          getAfter(fmPointerDoc(establishmentId, request.resource.data.floorManagerId)).data.openShiftId == shiftId
        ) ||
        (after == 'closed' && before in ['planned', 'open'] && sameServers);
    }
    function validParticipant(establishmentId, shiftId, serverId) {
      let d = request.resource.data;
      let shift = getAfter(shiftDoc(establishmentId, shiftId)).data;
      return d.keys().hasOnly([
          'shiftId', 'establishmentId', 'serverId', 'serverName',
          'assignedAt', 'assignedBy', 'activeInShift', 'removedAt', 'removedBy'
        ]) &&
        d.shiftId == shiftId &&
        d.establishmentId == establishmentId &&
        d.serverId == serverId &&
        d.activeInShift is bool &&
        d.activeInShift == (serverId in shift.serverIds) &&
        shift.status != 'closed' &&
        (d.activeInShift == false || isEstablishmentUser(serverId, establishmentId, 'serveur'));
    }
    // Un pointeur « service courant » ne peut quitter un service encore
    // ouvert (pour un serveur : un service ouvert dont il fait partie).
    function fmPointerReleased(establishmentId, previousShiftId, nextShiftId) {
      return previousShiftId == nextShiftId ||
        getAfter(shiftDoc(establishmentId, previousShiftId)).data.status != 'open';
    }
    function serverPointerReleased(establishmentId, previousShiftId, nextShiftId, serverId) {
      return previousShiftId == nextShiftId ||
        getAfter(shiftDoc(establishmentId, previousShiftId)).data.status != 'open' ||
        !(serverId in getAfter(shiftDoc(establishmentId, previousShiftId)).data.serverIds);
    }
    // ─────────────── COMMANDES : acteur ───────────────
    // Auteur réel (performedByUserId) = TOUJOURS l'utilisateur authentifié.
    // Serveur responsable (assignedServerId, miroir de createdBy pendant la
    // transition) :
    // - serveur, gérante, propriétaire, admin : soi-même uniquement ;
    // - floor_manager : soi-même ou un serveur présent dans SON service
    //   ouvert (shiftId obligatoire).
    // Anciens clients (sans performedBy / assignedServer) : createdBy doit
    // alors être l'utilisateur authentifié.
    function fmOpenShift(establishmentId, shiftId) {
      return shiftId is string && shiftId != '' &&
        exists(shiftDoc(establishmentId, shiftId)) &&
        get(shiftDoc(establishmentId, shiftId)).data.status == 'open' &&
        get(shiftDoc(establishmentId, shiftId)).data.floorManagerId == request.auth.uid;
    }
    function fmCanAssign(establishmentId, shiftId, serverId) {
      return serverId in get(shiftDoc(establishmentId, shiftId)).data.serverIds &&
        exists(serverPointerDoc(establishmentId, serverId)) &&
        get(serverPointerDoc(establishmentId, serverId)).data.openShiftId == shiftId &&
        isEstablishmentUser(serverId, establishmentId, 'serveur');
    }
    function validOrderActor(establishmentId) {
      let d = request.resource.data;
      let assigned = d.get('assignedServerId', d.get('createdBy', ''));
      let shiftId = d.get('shiftId', null);
      return d.get('performedByUserId', request.auth.uid) == request.auth.uid &&
        d.get('createdBy', '') == assigned &&
        (
          (!isFloorManager() && assigned == request.auth.uid && shiftId == null) ||
          (
            isFloorManager() && fmOpenShift(establishmentId, shiftId) &&
            (assigned == request.auth.uid || fmCanAssign(establishmentId, shiftId, assigned))
          )
        );
    }

    // Floor Manager actuellement DANS un service ouvert de cet établissement
    // (son pointeur désigne un service ouvert ; les règles des pointeurs
    // garantissent que ce service est bien le sien). Condition de TOUS ses
    // droits de prise de commande : hors service, il ne lit ni n'écrit rien.
    function fmOnOpenShift(establishmentId) {
      return isFloorManager() &&
        userEstablishmentId() == establishmentId &&
        exists(fmPointerDoc(establishmentId, request.auth.uid)) &&
        get(shiftDoc(establishmentId, get(fmPointerDoc(establishmentId, request.auth.uid)).data.openShiftId)).data.status == 'open';
    }

    // Commande déjà payée : ses champs de paiement ne sont jamais réécrits
    // (un second encaissement concurrent échoue ici, côté serveur).
    function paymentNotRewritten() {
      return resource.data.get('paymentStatus', '') != 'paid' ||
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['paymentStatus', 'paymentId', 'paidAt']);
    }
    // Le paiement [paymentId] est créé dans ce lot par l'utilisateur, comme
    // encaisseur réel, et couvre bien la commande [orderId].
    function fmCreatesPaymentInThisBatch(establishmentId, paymentId, orderId) {
      return paymentId is string && paymentId != '' &&
        !exists(/databases/$(database)/documents/establishments/$(establishmentId)/payments/$(paymentId)) &&
        existsAfter(/databases/$(database)/documents/establishments/$(establishmentId)/payments/$(paymentId)) &&
        getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/payments/$(paymentId)).data.receivedBy == request.auth.uid &&
        orderId in getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/payments/$(paymentId)).data.orderIds;
    }

    // ─────────────── CLÔTURE FINANCIÈRE D'UN SERVICE (13B) ───────────────
    // État financier stocké, distinct de l'état opérationnel `status` :
    // absent / 'pending' ou 'reconciled' (figé). Un ancien service sans ce
    // champ n'est jamais considéré comme soldé.
    function notFinanciallyClosed(data) {
      return data.get('financialStatus', 'pending') != 'reconciled';
    }
    // Tout événement financier d'un service (remise, décision, écart) fait
    // avancer son compteur de 1 dans le même lot. Conséquences :
    // - une clôture lancée entre-temps échoue (compteur changé) ;
    // - après clôture, l'incrément est refusé, donc l'événement aussi.
    function shiftFinancialEventBumped(establishmentId, shiftId) {
      return getAfter(shiftDoc(establishmentId, shiftId)).data.get('financialRevision', 0) ==
        get(shiftDoc(establishmentId, shiftId)).data.get('financialRevision', 0) + 1;
    }

    // ─────────────── REMISES SERVEUR -> FLOOR MANAGER (11B) ───────────────
    function participantDoc(establishmentId, shiftId, serverId) {
      return /databases/$(database)/documents/establishments/$(establishmentId)/shifts/$(shiftId)/participants/$(serverId);
    }
    // Le serveur connecté est présent dans ce service OUVERT : seul cas où
    // un paiement qu'il encaisse peut porter ce shiftId.
    function serverActiveInOpenShift(establishmentId, shiftId) {
      return shiftId is string &&
        get(serverPointerDoc(establishmentId, request.auth.uid)).data.openShiftId == shiftId &&
        get(shiftDoc(establishmentId, shiftId)).data.status == 'open' &&
        request.auth.uid in get(shiftDoc(establishmentId, shiftId)).data.serverIds;
    }
    function isFmHandover(data) {
      return data.get('receiverRole', '') == 'floor_manager';
    }
    // Remise serveur -> Floor Manager : émetteur = soi, destinataire = le
    // Floor Manager du service (jamais un choix libre), service dont il est
    // (ou a été) participant — ouvert OU clôturé, pour finaliser.
    function validFmHandoverCreate(establishmentId, handoverId) {
      let d = request.resource.data;
      return isServeur() &&
        d.serveurId == request.auth.uid &&
        d.senderUserId == request.auth.uid &&
        d.senderRole == 'serveur' &&
        d.createdBy == request.auth.uid &&
        d.shiftId is string &&
        exists(participantDoc(establishmentId, d.shiftId, request.auth.uid)) &&
        d.receiverUserId == get(shiftDoc(establishmentId, d.shiftId)).data.floorManagerId &&
        d.status == 'pending' &&
        d.paymentIds is list && d.paymentIds.size() > 0 &&
        d.validatedPaymentIds.size() == 0 &&
        d.rejectedPaymentIds.size() == 0 &&
        d.declaredAmount is number && d.declaredAmount > 0 &&
        d.get('validatedAmount', null) == null &&
        shiftFinancialEventBumped(establishmentId, d.shiftId) &&
        // Ancrage : le premier paiement listé bascule dans CETTE remise
        // dans le même lot (les règles ne bouclent pas sur la liste ; chaque
        // autre paiement est contrôlé par sa propre règle de mise à jour).
        getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/payments/$(d.paymentIds[0])).data.get('handoverId', '') == handoverId;
    }

    // ─────────────── REMISES FLOOR MANAGER -> GÉRANTE (12B) ───────────────
    function isFmTransfer(data) {
      return data.get('senderRole', '') == 'floor_manager';
    }
    // Détail par moyen de paiement : moyens connus, montants >= 0, et total
    // égal au montant déclaré (même ordre d'addition que l'application).
    function validBreakdown(b, amount) {
      return b is map &&
        b.keys().hasOnly(['cash', 'mobile_money', 'card', 'credit',
                          'bank_transfer', 'mixed', 'benin_resto']) &&
        b.get('cash', 0) >= 0 && b.get('mobile_money', 0) >= 0 &&
        b.get('card', 0) >= 0 && b.get('credit', 0) >= 0 &&
        b.get('bank_transfer', 0) >= 0 && b.get('mixed', 0) >= 0 &&
        b.get('benin_resto', 0) >= 0 &&
        b.get('cash', 0) + b.get('mobile_money', 0) + b.get('card', 0) +
          b.get('credit', 0) + b.get('bank_transfer', 0) + b.get('mixed', 0) +
          b.get('benin_resto', 0) == amount;
    }
    // Remise créée par le Floor Manager du service (ouvert OU clôturé),
    // adressée au créateur du service (gérante / propriétaire actif de cet
    // établissement), jamais à un destinataire libre. Identifiant imposé
    // par le rang : deux remises calculées sur la même situation visent le
    // même document, la seconde échoue (création sur document existant).
    function validFmTransferCreate(establishmentId, handoverId) {
      let d = request.resource.data;
      let shift = get(shiftDoc(establishmentId, d.shiftId)).data;
      return isFloorManager() &&
        d.keys().hasOnly([
          'establishmentId', 'serveurId', 'serveurName', 'declaredAmount',
          'amount', 'validatedAmount', 'status', 'receivedByManagerId',
          'receivedByManagerName', 'paymentIds', 'validatedPaymentIds',
          'rejectedPaymentIds', 'shiftId', 'senderUserId', 'senderUserName',
          'senderRole', 'receiverUserId', 'receiverUserName', 'receiverRole',
          'paymentBreakdown', 'transferSequence', 'comment', 'createdBy',
          'createdAt', 'updatedAt', 'validatedAt', 'validatedBy',
          'physicalAmount', 'difference', 'rejectedAt', 'rejectedBy',
          'rejectedByName', 'decisionComment', 'pendingSync', 'syncError'
        ]) &&
        d.establishmentId == establishmentId &&
        d.senderUserId == request.auth.uid &&
        d.serveurId == request.auth.uid &&
        d.createdBy == request.auth.uid &&
        d.shiftId is string &&
        shift.floorManagerId == request.auth.uid &&
        d.receiverUserId == shift.get('cashReceiverId', shift.createdBy) &&
        d.receiverRole in ['gerante', 'proprietaire'] &&
        isEstablishmentUser(d.receiverUserId, establishmentId, d.receiverRole) &&
        d.status == 'pending' &&
        d.declaredAmount is number && d.declaredAmount > 0 &&
        d.amount == d.declaredAmount &&
        validBreakdown(d.paymentBreakdown, d.declaredAmount) &&
        d.paymentIds.size() == 0 &&
        d.validatedPaymentIds.size() == 0 &&
        d.rejectedPaymentIds.size() == 0 &&
        d.get('validatedAmount', null) == null &&
        d.get('physicalAmount', null) == null &&
        d.get('difference', null) == null &&
        d.get('validatedBy', null) == null &&
        d.get('rejectedBy', null) == null &&
        d.get('receivedByManagerId', null) == null &&
        d.transferSequence is int && d.transferSequence >= 0 &&
        shiftFinancialEventBumped(establishmentId, d.shiftId) &&
        handoverId == 'fmt_' + d.shiftId + '_' + request.auth.uid + '_' + string(d.transferSequence) &&
        (
          d.transferSequence == 0 ||
          exists(/databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$('fmt_' + d.shiftId + '_' + request.auth.uid + '_' + string(d.transferSequence - 1)))
        );
    }
    // Décision du destinataire sur une remise en attente. Le montant déclaré,
    // l'émetteur, le destinataire, le service et le détail sont figés ;
    // l'écart de caisse est tracé (physique − déclaré), jamais absorbé.
    function validFmTransferDecision(establishmentId) {
      let before = resource.data;
      let after = request.resource.data;
      return before.receiverUserId == request.auth.uid &&
        shiftFinancialEventBumped(establishmentId, before.shiftId) &&
        before.status == 'pending' &&
        (
          (
            after.status == 'validated' &&
            after.validatedAmount == before.declaredAmount &&
            after.physicalAmount is number && after.physicalAmount >= 0 &&
            after.difference == after.physicalAmount - before.declaredAmount &&
            after.validatedBy == request.auth.uid &&
            after.receivedByManagerId == request.auth.uid &&
            after.diff(before).affectedKeys().hasOnly([
              'status', 'validatedAmount', 'physicalAmount', 'difference',
              'validatedBy', 'receivedByManagerId', 'receivedByManagerName',
              'validatedAt', 'decisionComment', 'updatedAt',
              'pendingSync', 'syncError'
            ])
          ) ||
          (
            after.status == 'rejected' &&
            after.rejectedBy == request.auth.uid &&
            after.diff(before).affectedKeys().hasOnly([
              'status', 'rejectedBy', 'rejectedByName', 'rejectedAt',
              'decisionComment', 'updatedAt', 'pendingSync', 'syncError'
            ])
          )
        );
    }

    // Écart : sujet = Floor Manager du service ou serveur participant ;
    // manquant uniquement (0 <= physique <= attendu), écart = physique −
    // attendu, horodatage serveur, statut initial 'pending'.
    function validDiscrepancyCreate(establishmentId) {
      let d = request.resource.data;
      let shift = get(shiftDoc(establishmentId, d.shiftId)).data;
      return d.keys().hasOnly([
          'establishmentId', 'shiftId', 'subjectUserId', 'subjectName',
          'subjectRole', 'expectedAmount', 'physicalAmount', 'difference',
          'reason', 'recordedBy', 'recordedByName', 'recordedByRole',
          'recordedAt', 'status', 'approvedBy', 'approvedAt', 'rejectedBy',
          'rejectedAt', 'decidedByName', 'decisionComment'
        ]) &&
        d.establishmentId == establishmentId &&
        d.shiftId is string &&
        (
          (d.subjectRole == 'floor_manager' && d.subjectUserId == shift.floorManagerId) ||
          (d.subjectRole == 'serveur' && exists(participantDoc(establishmentId, d.shiftId, d.subjectUserId)))
        ) &&
        d.expectedAmount is number && d.expectedAmount > 0 &&
        d.physicalAmount is number && d.physicalAmount >= 0 &&
        d.physicalAmount <= d.expectedAmount &&
        d.difference == d.physicalAmount - d.expectedAmount &&
        d.reason is string && d.reason.size() > 0 &&
        d.recordedBy == request.auth.uid &&
        d.recordedByRole == userRole() &&
        d.recordedAt == request.time &&
        d.status == 'pending' &&
        d.get('approvedBy', null) == null &&
        d.get('rejectedBy', null) == null &&
        shiftFinancialEventBumped(establishmentId, d.shiftId);
    }

    // Service ouvert désigné par le pointeur du Floor Manager connecté.
    function fmOpenShiftId(establishmentId) {
      return get(fmPointerDoc(establishmentId, request.auth.uid)).data.openShiftId;
    }
    // Le Floor Manager peut encaisser une vente attribuée à [serverId] :
    // lui-même, ou un serveur présent dans SON service ouvert.
    function fmMayCollectFor(establishmentId, serverId) {
      return serverId == request.auth.uid ||
        fmCanAssign(establishmentId, fmOpenShiftId(establishmentId), serverId);
    }

    // La commande [orderId] n'existait pas avant ce lot et y est créée par
    // l'utilisateur (auteur réel) : lie une écriture de stock à UNE nouvelle
    // commande, sans rejeu possible.
    function fmCreatesOrderInThisBatch(establishmentId, orderId) {
      return orderId is string && orderId != '' &&
        !exists(/databases/$(database)/documents/establishments/$(establishmentId)/orders/$(orderId)) &&
        existsAfter(/databases/$(database)/documents/establishments/$(establishmentId)/orders/$(orderId)) &&
        getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/orders/$(orderId)).data.get('performedByUserId', '') == request.auth.uid;
    }

    // Le Floor Manager lit le profil d'un serveur UNIQUEMENT s'il est présent
    // dans son service actuellement ouvert.
    function isServerOfMyOpenShift(serverId) {
      let e = userEstablishmentId();
      let pointer = serverPointerDoc(e, serverId);
      return exists(pointer) &&
        get(pointer).data.floorManagerId == request.auth.uid &&
        get(shiftDoc(e, get(pointer).data.openShiftId)).data.status == 'open' &&
        get(shiftDoc(e, get(pointer).data.openShiftId)).data.floorManagerId == request.auth.uid &&
        serverId in get(shiftDoc(e, get(pointer).data.openShiftId)).data.serverIds;
    }
    function sameEstablishment(establishmentId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        userEstablishmentId() == establishmentId
      );
    }
    function handoverAfterContainsPayment(establishmentId, handoverId, paymentId) {
      let handoverPath = /databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(handoverId);
      return handoverId is string &&
        existsAfter(handoverPath) &&
        getAfter(handoverPath).data.paymentIds is list &&
        getAfter(handoverPath).data.paymentIds.hasAny([paymentId]);
    }
    function handoverAfterContainsPaymentInList(establishmentId, handoverId, paymentId, listField) {
      let handoverPath = /databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(handoverId);
      return handoverAfterContainsPayment(establishmentId, handoverId, paymentId) &&
        getAfter(handoverPath).data[listField] is list &&
        getAfter(handoverPath).data[listField].hasAny([paymentId]);
    }
    function validStore(store) {
      return store in ['restaurant', 'hotel', 'bar', 'divers'];
    }
    function canReadStore(store) {
      return isSignedIn() && (
        isAdminOrOwner() ||
        isGerante() ||
        isServeur() ||
        (store == 'restaurant' && isChefCuisine()) ||
        (store == 'bar' && isBarman()) ||
        (store == 'hotel' && isServiceHygiene())
      );
    }
    function canManageStore(store) {
      return isSignedIn() && (
        isAdminOrOwner() ||
        isGerante() ||
        (isServeur() && store in ['restaurant', 'bar', 'hotel']) ||
        (store == 'restaurant' && isChefCuisine()) ||
        (store == 'bar' && isBarman()) ||
        (store == 'hotel' && isServiceHygiene())
      );
    }
    // Champs du document établissement modifiables par propriétaire / gérante.
    function establishmentProfileFields() {
      return ['name', 'city', 'country', 'updatedAt'];
    }
    function canManageHotel() {
      return isSignedIn() && (
        isGerante() ||
        isAdminOrOwner() ||
        isServiceHygiene() ||
        isReceptionniste()
      );
    }

    // ─────────────── users (RACINE — pivot sécurité) ───────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (
          (isAdminOrOwner() || isGerante()) &&
          resource.data.establishmentId == userEstablishmentId()
        ) ||
        (
          isFloorManager() &&
          resource.data.establishmentId == userEstablishmentId() &&
          resource.data.role == 'serveur' &&
          isServerOfMyOpenShift(userId)
        ) ||
        (
          // 14A : constitution de son service.
          isFloorManager() &&
          resource.data.establishmentId == userEstablishmentId() &&
          resource.data.role in ['serveur', 'gerante', 'proprietaire']
        )
      );
      // Root profiles are created by the authenticated Admin SDK callables.
      allow create: if false;
      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fcmToken', 'lastTokenUpdate'])
        ) ||
        (
          isSuperAdmin() &&
          request.auth.uid != userId &&
          canChangeProfileRole([
            'global_admin', 'super_admin', 'proprietaire', 'gerante',
            'comptable', 'chef_cuisine', 'serveur', 'service_hygiene',
            'hygiene', 'barman', 'majordhomme', 'receptionniste'
          ])
        ) ||
        (
          request.auth.uid != userId &&
          (isAdminOrOwner() || isGerante()) &&
          resource.data.establishmentId == userEstablishmentId() &&
          request.resource.data.establishmentId == resource.data.establishmentId &&
          canChangeProfileRole([
            'gerante', 'comptable', 'chef_cuisine', 'serveur',
            'service_hygiene', 'hygiene', 'barman', 'majordhomme',
            'receptionniste'
          ])
        )
      );
      allow delete: if isSuperAdmin() || (
        isAdminOrOwner() &&
        resource.data.establishmentId == userEstablishmentId()
      );
    }

    // ─────────────── modules (RACINE — catalogue global, lecture seule) ───────────────
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─────────────── establishments + sous-collections ───────────────
    match /establishments/{establishmentId} {
      allow read: if sameEstablishment(establishmentId);
      allow create: if isSuperAdmin();
      // Paramètres plateforme (abonnement, contrôle, identité légale) :
      // stockMode, modules, plan, status, type, ownerUid, ifu, createdAt…
      // => administration plateforme uniquement.
      //
      // Propriétaire / gérante : LISTE BLANCHE de la fiche descriptive. Tout
      // autre champ, y compris un champ nouveau ou inconnu, est refusé : une
      // gérante ne peut ni s'ouvrir un module, ni changer de plan, ni
      // réactiver un établissement suspendu.
      allow update: if sameEstablishment(establishmentId) && (
        isSuperAdmin() || (
          (isAdminOrOwner() || isGerante()) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(establishmentProfileFields())
        )
      );
      allow delete: if isSuperAdmin();

      match /certilink_config/{docId} {
        allow read: if tenantReader(establishmentId);
        allow write: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
      }

      // Base clients partagée (hôtel, bar/restaurant, facturation)
      match /clients/{clientId} {
        allow read: if tenantReader(establishmentId);
        allow create, update, delete: if sameEstablishment(establishmentId) && (
          canManageHotel() || isServeur() || isAccounting()
        );
      }

      // ─────────────── MODULE HÔTEL ───────────────
      match /roomTypes/{typeId} {
        allow read: if tenantReader(establishmentId);
        allow create, update, delete: if sameEstablishment(establishmentId)
          && canManageHotel();
      }

      match /rooms/{roomId} {
        allow read: if tenantReader(establishmentId);
        allow create, update, delete: if sameEstablishment(establishmentId)
          && canManageHotel();
      }

      match /reservations/{reservationId} {
        allow read: if tenantReader(establishmentId);
        allow create, update, delete: if sameEstablishment(establishmentId)
          && canManageHotel();
      }

      match /roomExtras/{extraId} {
        allow read, create, update: if sameEstablishment(establishmentId) && (
          isServeur() || isGerante() || isAccounting() || isAdminOrOwner() || isReceptionniste()
        );
        allow delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
      }

      match /roomInvoices/{id} {
        allow read, create, update: if sameEstablishment(establishmentId) && (
          isServeur() || isGerante() || isAccounting() || isAdminOrOwner() || isReceptionniste()
        );
        allow delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
      }

    match /menuItems/{itemId} {
          // Floor Manager : le menu, pendant son service uniquement.
          allow read: if tenantReader(establishmentId) ||
            fmOnOpenShift(establishmentId);

          // Création : gérante/admin sans restriction.
          // Le chef peut créer un plat CUISINE uniquement, sans prix (0).
          // Le barman peut créer un article BAR uniquement, sans prix (0).
          allow create: if sameEstablishment(establishmentId) && (
            isAdminOrOwner() ||
            isGerante() ||
            (
              isChefCuisine() &&
              request.resource.data.isForKitchen == true &&
              request.resource.data.isForBar == false &&
              request.resource.data.price == 0
            ) ||
            (
              isBarman() &&
              request.resource.data.isForBar == true &&
              request.resource.data.isForKitchen == false &&
              request.resource.data.price == 0
            )
          );

          // Suppression : réservée à la gérante/admin.
          allow delete: if sameEstablishment(establishmentId) &&
            (isAdminOrOwner() || isGerante());

          allow update: if sameEstablishment(establishmentId) && (
            isAdminOrOwner() ||
            isGerante() ||
            (
              isChefCuisine() &&
              request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(['ingredients', 'composition', 'allowsFreeAccompaniment', 'adresse', 'updatedAt', 'pendingSync', 'syncError'])
            ) ||
            (
              isBarman() &&
              request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(['ingredients', 'composition', 'adresse', 'updatedAt', 'pendingSync', 'syncError'])
            )
          );
        }
      match /orders/{orderId} {
        // Floor Manager, pendant son service : uniquement les commandes NON
        // ENCAISSÉES (le moteur y cherche l'addition ouverte de la table pour
        // y rattacher la nouvelle commande). Jamais l'historique encaissé.
        allow read: if tenantReader(establishmentId) || (
          fmOnOpenShift(establishmentId) &&
          resource.data.paymentStatus == 'unpaid'
        );
        // Acteur validé (auteur réel = auth.uid, serveur responsable
        // autorisé) : voir validOrderActor.
        allow create: if sameEstablishment(establishmentId) && (
          isServeur() || isGerante() || isAdminOrOwner() || isFloorManager()
        ) && validOrderActor(establishmentId);
        // Les acteurs sont figés à la création.
        allow update: if (
          sameEstablishment(establishmentId) && (
            isServeur() || isGerante() || isChefCuisine() || isBarman() || isAdminOrOwner()
          ) && unchangedFields([
            'createdBy', 'createdByName',
            'performedByUserId', 'performedByUserName',
            'assignedServerId', 'assignedServerName', 'shiftId'
          ]) &&
          // Double encaissement : une commande payée ne l'est qu'une fois ;
          // son paiement (paymentStatus, paymentId, paidAt) est figé.
          paymentNotRewritten()
        ) || (
          // Floor Manager : seulement rattacher une ancienne commande non
          // encaissée, sans addition, à l'addition de la table (moteur).
          fmOnOpenShift(establishmentId) &&
          resource.data.paymentStatus == 'unpaid' &&
          resource.data.get('ticketId', '') == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketId'])
        ) || (
          // Floor Manager (10B) : solder une commande non encaissée, prête,
          // d'une vente attribuée à lui-même ou à un serveur de SON service,
          // par un paiement qu'il crée dans ce même lot en tant
          // qu'encaisseur réel.
          fmOnOpenShift(establishmentId) &&
          resource.data.paymentStatus == 'unpaid' &&
          resource.data.get('status', '') != 'cancelled' &&
          (resource.data.get('isForKitchen', false) != true ||
            resource.data.get('kitchenStatus', '') in ['ready', 'served']) &&
          (resource.data.get('isForBar', false) != true ||
            resource.data.get('barStatus', '') in ['ready', 'served']) &&
          fmMayCollectFor(
            establishmentId,
            resource.data.get('assignedServerId', resource.data.get('createdBy', ''))
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'paymentStatus', 'status', 'paymentId', 'paidAt', 'updatedAt',
            'pendingSync', 'syncError'
          ]) &&
          request.resource.data.paymentStatus == 'paid' &&
          fmCreatesPaymentInThisBatch(establishmentId, request.resource.data.paymentId, orderId)
        );
        allow delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
        match /items/{itemId} {
          allow read: if tenantReader(establishmentId);
          allow create: if sameEstablishment(establishmentId) && (
            isServeur() || isGerante() || isAdminOrOwner() ||
            // Floor Manager : lignes de SA commande, pendant son service.
            (
              fmOnOpenShift(establishmentId) &&
              getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/orders/$(orderId)).data.get('performedByUserId', '') == request.auth.uid
            )
          );
          allow update: if sameEstablishment(establishmentId) && (
            isServeur() || isGerante() || isChefCuisine() || isBarman() || isAdminOrOwner()
          );
          allow delete: if sameEstablishment(establishmentId) &&
            (isAdminOrOwner() || isGerante());
        }
      }

      match /payments/{paymentId} {
        // Floor Manager (11B) : uniquement les encaissements de SES services
        // (remises et situation par serveur), jamais un accès général.
        allow read: if tenantReader(establishmentId) || (
          isFloorManager() &&
          sameEstablishment(establishmentId) &&
          resource.data.get('shiftId', '') != '' &&
          get(shiftDoc(establishmentId, resource.data.shiftId)).data.floorManagerId == request.auth.uid
        );
        allow create: if (
          sameEstablishment(establishmentId) && (
            isServeur() || isGerante() || isAdminOrOwner()
          ) &&
          // Un paiement ne porte un service que si l'encaisseur est un
          // serveur présent dans ce service OUVERT (11B).
          (
            request.resource.data.get('shiftId', null) == null ||
            (isServeur() && serverActiveInOpenShift(establishmentId, request.resource.data.shiftId))
          )
        ) || (
          // Floor Manager (10B) : encaisseur réel = lui ; vente attribuée à
          // lui-même ou à un serveur de SON service ouvert ; jamais de note
          // « chambre » ; la commande principale est soldée par ce même lot.
          fmOnOpenShift(establishmentId) &&
          request.resource.data.receivedBy == request.auth.uid &&
          request.resource.data.get('shiftId', '') == fmOpenShiftId(establishmentId) &&
          fmMayCollectFor(establishmentId, request.resource.data.get('responsibleServerId', '')) &&
          request.resource.data.method != 'room' &&
          request.resource.data.status == 'confirmed' &&
          request.resource.data.handoverStatus == 'pending' &&
          request.resource.data.orderIds is list &&
          request.resource.data.orderIds.size() > 0 &&
          getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/orders/$(request.resource.data.orderId)).data.get('paymentId', '') == paymentId
        );
        allow update: if sameEstablishment(establishmentId) && (
          (
            isServeur() &&
            resource.data.receivedBy == request.auth.uid &&
            resource.data.handoverStatus == 'pending' &&
            request.resource.data.handoverStatus == 'declared' &&
            handoverAfterContainsPayment(establishmentId, request.resource.data.handoverId, paymentId) &&
            getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(request.resource.data.handoverId)).data.serveurId == request.auth.uid &&
            // Circuit gérante : paiements hors service uniquement. Remise
            // vers un Floor Manager : uniquement des paiements de CE service
            // (jamais un paiement historique sans shiftId).
            (
              (
                !isFmHandover(getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(request.resource.data.handoverId)).data) &&
                resource.data.get('shiftId', null) in [null, '']
              ) || (
                isFmHandover(getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(request.resource.data.handoverId)).data) &&
                resource.data.get('shiftId', '') == getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(request.resource.data.handoverId)).data.shiftId
              )
            ) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'handoverStatus', 'handoverId', 'updatedAt',
                'pendingSync', 'syncError'
              ]) &&
            request.resource.data.pendingSync == false &&
            request.resource.data.syncError == false
          ) ||
          (
            // Validation / rejet d'une remise : par la gérante pour le
            // circuit historique, par SON destinataire pour une remise
            // destinée à un Floor Manager (11B).
            (
              (
                (isGerante() || isAdminOrOwner()) &&
                !isFmHandover(get(/databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(resource.data.handoverId)).data)
              ) ||
              (
                isFloorManager() &&
                isFmHandover(get(/databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(resource.data.handoverId)).data) &&
                get(/databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(resource.data.handoverId)).data.receiverUserId == request.auth.uid
              )
            ) &&
            resource.data.handoverStatus == 'declared' &&
            resource.data.handoverId is string &&
            (
              (
                request.resource.data.handoverStatus == 'validated' &&
                request.resource.data.handoverId == resource.data.handoverId &&
                handoverAfterContainsPaymentInList(establishmentId, resource.data.handoverId, paymentId, 'validatedPaymentIds')
              ) ||
              (
                request.resource.data.handoverStatus == 'pending' &&
                request.resource.data.handoverId == null &&
                handoverAfterContainsPaymentInList(establishmentId, resource.data.handoverId, paymentId, 'rejectedPaymentIds')
              )
            ) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'handoverStatus', 'handoverId', 'updatedAt',
                'pendingSync', 'syncError'
              ]) &&
            request.resource.data.pendingSync == false &&
            request.resource.data.syncError == false
          ) ||
          (
            isAccounting() &&
            request.resource.data.handoverStatus == 'validated' &&
            resource.data.handoverId is string &&
            request.resource.data.handoverId == resource.data.handoverId &&
            getAfter(/databases/$(database)/documents/establishments/$(establishmentId)/serverHandovers/$(resource.data.handoverId)).data.accountingTransferStatus == 'received' &&
            handoverAfterContainsPayment(establishmentId, resource.data.handoverId, paymentId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['handoverStatus', 'updatedAt'])
          )
        );
        allow delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
      }

      match /serverHandovers/{handoverId} {
        // Floor Manager : uniquement les remises qui lui sont destinées, et
        // les siennes à la gérante (12B). Une remise Floor Manager -> gérante
        // n'est lue que par les rôles financiers (et son émetteur).
        allow read: if (
          tenantReader(establishmentId) && (
            isGerante() || isAccounting() || isAdminOrOwner() ||
            resource.data.get('serveurId', '') == request.auth.uid ||
            !isFmTransfer(resource.data)
          )
        ) || (
          isFloorManager() &&
          sameEstablishment(establishmentId) && (
            resource.data.get('receiverUserId', '') == request.auth.uid ||
            resource.data.get('senderUserId', '') == request.auth.uid
          )
        );
        allow create: if (
          // Circuit historique serveur -> gérante (inchangé).
          sameEstablishment(establishmentId) && (
            isServeur() || isGerante() || isAdminOrOwner()
          ) &&
          !isFmHandover(request.resource.data) &&
          !isFmTransfer(request.resource.data)
        ) || (
          // Floor Manager -> gérante (12B).
          sameEstablishment(establishmentId) &&
          isFmTransfer(request.resource.data) &&
          validFmTransferCreate(establishmentId, handoverId)
        ) || (
          // Serveur -> Floor Manager de son service (11B).
          sameEstablishment(establishmentId) &&
          isFmHandover(request.resource.data) &&
          validFmHandoverCreate(establishmentId, handoverId)
        );
        allow update: if (
          sameEstablishment(establishmentId) && (
            isGerante() || isAccounting() || isAdminOrOwner()
          ) &&
          // Une remise destinée à un Floor Manager n'est pas traitée par
          // le circuit gérante / comptabilité, ni une remise d'un Floor
          // Manager (12B, règles dédiées ci-dessous).
          !isFmHandover(resource.data) &&
          !isFmTransfer(resource.data)
        ) || (
          // Remise Floor Manager -> gérante : décision de SON destinataire.
          sameEstablishment(establishmentId) &&
          isFmTransfer(resource.data) &&
          validFmTransferDecision(establishmentId)
        ) || (
          // Remise Floor Manager validée : suivi de son versement en
          // comptabilité (circuit gérante -> comptabilité existant). Les
          // champs financiers restent figés.
          sameEstablishment(establishmentId) &&
          (isGerante() || isAccounting() || isAdminOrOwner()) &&
          isFmTransfer(resource.data) &&
          resource.data.status == 'validated' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accountingTransferStatus', 'accountingTransferId', 'updatedAt'
          ])
        ) || (
          // Floor Manager destinataire : valide / rejette une remise
          // ouverte. Émetteur, destinataire, service, paiements et montant
          // déclaré sont figés ; une remise validée ne bouge plus.
          isFloorManager() &&
          sameEstablishment(establishmentId) &&
          isFmHandover(resource.data) &&
          resource.data.receiverUserId == request.auth.uid &&
          resource.data.status in ['pending', 'partially_validated'] &&
          shiftFinancialEventBumped(establishmentId, resource.data.shiftId) &&
          request.resource.data.status in ['partially_validated', 'validated'] &&
          request.resource.data.receivedByManagerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'validatedPaymentIds', 'rejectedPaymentIds', 'validatedAmount',
            'status', 'receivedByManagerId', 'receivedByManagerName',
            'validatedAt', 'updatedAt', 'pendingSync', 'syncError'
          ])
        );
        // Historique des remises vers un Floor Manager conservé.
        allow delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante()) &&
          !isFmHandover(resource.data) &&
          !isFmTransfer(resource.data);
      }

      match /managerToAccountingTransfers/{transferId} {
        // Remises gérante → comptabilité : mêmes rôles qu'en écriture.
        allow read: if sameEstablishment(establishmentId) && (
          isGerante() || isAccounting() || isAdminOrOwner()
        );
        allow create, update: if sameEstablishment(establishmentId) && (
          isGerante() || isAccounting() || isAdminOrOwner()
        );
        allow delete: if sameEstablishment(establishmentId) && isAdminOrOwner();
      }

      match /stock_items/{itemId} {
        allow read: if tenantReader(establishmentId);
        allow create: if sameEstablishment(establishmentId)
          && validStore(request.resource.data.store)
          && canManageStore(request.resource.data.store);
        allow update: if sameEstablishment(establishmentId)
          && validStore(request.resource.data.store)
          && resource.data.store == request.resource.data.store
          && canManageStore(resource.data.store);
        allow delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
      }

      match /store_stocks/{stockId} {
        // Floor Manager : comme un serveur pour la prise de commande
        // (lecture des magasins), pendant son service uniquement.
        allow read: if (
          sameEstablishment(establishmentId) &&
          canReadStore(resource.data.store)
        ) || fmOnOpenShift(establishmentId);
        allow create: if sameEstablishment(establishmentId)
          && validStore(request.resource.data.store)
          && canManageStore(request.resource.data.store);
        allow update: if (
          sameEstablishment(establishmentId)
          && validStore(request.resource.data.store)
          && resource.data.store == request.resource.data.store
          && canManageStore(resource.data.store)
        ) || (
          // Floor Manager : DÉDUCTION de commande uniquement (quantité en
          // baisse, jamais négative, champs de déduction seulement), dans les
          // mêmes magasins qu'un serveur, LIÉE à une commande qu'il crée dans
          // ce même lot (lastOrderId) : pas de déduction isolée ni rejouée.
          fmOnOpenShift(establishmentId)
          && resource.data.store in ['restaurant', 'bar', 'hotel']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantity', 'isLowStock', 'lastOrderId', 'updatedAt', 'pendingSync', 'syncError'])
          && request.resource.data.quantity is number
          && request.resource.data.quantity >= 0
          && request.resource.data.quantity < resource.data.quantity
          && fmCreatesOrderInThisBatch(establishmentId, request.resource.data.get('lastOrderId', ''))
        );
        allow delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
      }

      match /stock_movements/{movementId} {
        allow read: if sameEstablishment(establishmentId) &&
          canReadStore(resource.data.store);
        allow create: if (
          sameEstablishment(establishmentId)
          && validStore(request.resource.data.store)
          && canManageStore(request.resource.data.store)
        ) || (
          // Floor Manager : sortie liée à SA commande, écrite dans le même
          // lot que la commande (getAfter), pendant son service.
          fmOnOpenShift(establishmentId)
          && request.resource.data.store in ['restaurant', 'bar', 'hotel']
          && request.resource.data.movementType == 'out'
          && request.resource.data.performedBy == request.auth.uid
          && fmCreatesOrderInThisBatch(establishmentId, request.resource.data.get('orderId', ''))
        );
        allow update, delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
      }

      match /stock_requests/{requestId} {
        allow read: if sameEstablishment(establishmentId) &&
          canReadStore(resource.data.store);
        allow create: if sameEstablishment(establishmentId)
          && validStore(request.resource.data.store)
          && canManageStore(request.resource.data.store);
        allow update: if sameEstablishment(establishmentId) && (
          canManageStore(resource.data.store) || isGerante() || isAdminOrOwner()
        );
        allow delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
        match /items/{itemId} {
          allow read: if tenantReader(establishmentId);
          allow create, update: if sameEstablishment(establishmentId) && (
            isGerante() || isAdminOrOwner() ||
            canManageStore(
              get(/databases/$(database)/documents/establishments/$(establishmentId)/stock_requests/$(requestId)).data.store
            )
          );
          allow delete: if sameEstablishment(establishmentId) &&
            (isAdminOrOwner() || isGerante());
        }
      }

      match /hygiene_daily_entries/{entryId} {
        allow read, create: if sameEstablishment(establishmentId) && (
          isGerante() || isServiceHygiene() || isAdminOrOwner()
        );
        allow update, delete: if sameEstablishment(establishmentId) && (
          isGerante() || isAdminOrOwner()
        );
        match /items/{itemId} {
          allow read, create: if sameEstablishment(establishmentId) && (
            isGerante() || isServiceHygiene() || isAdminOrOwner()
          );
          allow update, delete: if sameEstablishment(establishmentId) && (
            isGerante() || isAdminOrOwner()
          );
        }
      }

      match /serverNotifications/{notificationId} {
        allow read: if sameEstablishment(establishmentId) && (
          isAdminOrOwner() ||
          isGerante() ||
          isBarman() ||
          isChefCuisine() ||
          (
            isServeur() &&
            resource.data.serveurId == request.auth.uid
          ) ||
          // Tout membre lit SES notifications : AuthService écoute
          // `serveurId == uid` à la connexion, quel que soit le rôle. Le
          // Floor Manager compris : il est destinataire des « prêt » de ses
          // commandes directes (9B) — les siennes seulement.
          (
            sameEstablishment(establishmentId) &&
            resource.data.serveurId == request.auth.uid
          )
        );
        allow create: if sameEstablishment(establishmentId) && (
          isAdminOrOwner() || isGerante() || isBarman() || isChefCuisine()
        );
        allow update: if sameEstablishment(establishmentId) && (
          isAdminOrOwner() ||
          isGerante() ||
          (
            isServeur() &&
            resource.data.serveurId == request.auth.uid &&
            request.resource.data.serveurId == resource.data.serveurId &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['isRead', 'readAt', 'updatedAt'])
          )
        );
        allow delete: if sameEstablishment(establishmentId) &&
          (isAdminOrOwner() || isGerante());
      }

      match /accountOpeningBalances/{balanceId} {
        allow read, create, update: if sameEstablishment(establishmentId) && (
          isGerante() || isAccounting() || isAdminOrOwner()
        );
        allow delete: if sameEstablishment(establishmentId) && isAdminOrOwner();
      }

      match /accountClosures/{closureId} {
        allow read, create, update: if sameEstablishment(establishmentId) && (
          isGerante() || isAccounting() || isAdminOrOwner()
        );
        allow delete: if sameEstablishment(establishmentId) && isAdminOrOwner();
      }

      match /expenses/{expenseId} {
        allow read, create, update: if sameEstablishment(establishmentId) && (
          isGerante() || isAccounting() || isAdminOrOwner()
        );
        allow delete: if sameEstablishment(establishmentId) && isAdminOrOwner();
      }

      // ─────────────── ÉCARTS DE CAISSE D'UN SERVICE (13B) ───────────────
      // Document à part : un écart ne modifie jamais un paiement ou une
      // remise. Déclaré par la gérante ou le Floor Manager du service,
      // décidé UNIQUEMENT par la gérante / le propriétaire.
      match /shiftDiscrepancies/{discrepancyId} {
        allow read: if sameEstablishment(establishmentId) && (
          isShiftManager() || isAccounting() ||
          (
            isFloorManager() &&
            get(shiftDoc(establishmentId, resource.data.shiftId)).data.floorManagerId == request.auth.uid
          ) ||
          (isServeur() && resource.data.subjectUserId == request.auth.uid)
        );
        allow create: if sameEstablishment(establishmentId) && (
          isShiftManager() ||
          (
            isFloorManager() &&
            get(shiftDoc(establishmentId, request.resource.data.shiftId)).data.floorManagerId == request.auth.uid
          )
        ) && validDiscrepancyCreate(establishmentId);
        allow update: if sameEstablishment(establishmentId) &&
          isShiftManager() &&
          resource.data.status == 'pending' &&
          shiftFinancialEventBumped(establishmentId, resource.data.shiftId) &&
          (
            (
              request.resource.data.status == 'approved' &&
              request.resource.data.approvedBy == request.auth.uid &&
              request.resource.data.approvedAt == request.time &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'approvedBy', 'approvedAt', 'decidedByName', 'decisionComment'
              ])
            ) ||
            (
              request.resource.data.status == 'rejected' &&
              request.resource.data.rejectedBy == request.auth.uid &&
              request.resource.data.rejectedAt == request.time &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'rejectedBy', 'rejectedAt', 'decidedByName', 'decisionComment'
              ])
            )
          );
        // Historique conservé.
        allow delete: if false;
      }

      // ─────────────── SERVICES (SHIFTS) ───────────────
      match /shifts/{shiftId} {
        allow read: if sameEstablishment(establishmentId) && (
          isShiftManager() ||
          (isFloorManager() && resource.data.floorManagerId == request.auth.uid) ||
          (isServeur() && request.auth.uid in resource.data.serverIds) ||
          // Serveur retiré en cours de service : il doit encore pouvoir
          // remettre les encaissements de ce service (11B).
          (isServeur() && exists(participantDoc(establishmentId, shiftId, request.auth.uid)))
        );
        allow create: if sameEstablishment(establishmentId) &&
          (
            isShiftManager() ||
            (
              isFloorManager() &&
              request.resource.data.floorManagerId == request.auth.uid &&
              'cashReceiverId' in request.resource.data
            )
          ) &&
          validCashReceiver(establishmentId) &&
          validShiftData(establishmentId) &&
          validShiftFloorManager(establishmentId) &&
          request.resource.data.status == 'planned' &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.get('createdByRole', userRole()) == userRole() &&
          request.resource.data.get('financialStatus', 'pending') == 'pending' &&
          request.resource.data.get('financialRevision', 0) == 0;
        allow update: if (
          sameEstablishment(establishmentId) &&
          (isShiftManager() || fmManagesOwnShift()) &&
          // Service clôturé financièrement : plus aucune modification
          // (ni réouverture, ni affectation).
          notFinanciallyClosed(resource.data) &&
          validShiftData(establishmentId) &&
          validShiftFloorManager(establishmentId) &&
          unchangedFields([
            'establishmentId', 'floorManagerId', 'floorManagerName',
            'createdAt', 'createdBy', 'createdByName', 'createdByRole',
            'financialStatus', 'financialRevision', 'financialClosedAt',
            'financialClosedBy', 'financialClosedByName', 'financialSummary',
            'cashReceiverId', 'cashReceiverName', 'cashReceiverRole'
          ]) &&
          validShiftTransition(establishmentId, shiftId)
        ) || (
          // Événement financier (13B) : +1 sur le compteur, rien d'autre, par
          // un acteur du service, tant qu'il n'est pas clôturé.
          sameEstablishment(establishmentId) &&
          notFinanciallyClosed(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['financialRevision']) &&
          request.resource.data.financialRevision == resource.data.get('financialRevision', 0) + 1 &&
          (
            isShiftManager() ||
            (isFloorManager() && resource.data.floorManagerId == request.auth.uid) ||
            (isServeur() && exists(participantDoc(establishmentId, shiftId, request.auth.uid)))
          )
        ) || (
          // Clôture financière (13B) : gérante / propriétaire, service
          // TERMINÉ, compteur inchangé depuis la lecture (aucun événement
          // concurrent), une seule fois. Les montants sont figés.
          sameEstablishment(establishmentId) && isShiftManager() &&
          resource.data.status == 'closed' &&
          notFinanciallyClosed(resource.data) &&
          request.resource.data.financialStatus == 'reconciled' &&
          request.resource.data.financialClosedBy == request.auth.uid &&
          request.resource.data.financialClosedAt == request.time &&
          request.resource.data.financialSummary is map &&
          request.resource.data.get('financialRevision', 0) == resource.data.get('financialRevision', 0) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'financialStatus', 'financialClosedAt', 'financialClosedBy',
            'financialClosedByName', 'financialSummary', 'updatedAt'
          ])
        );
        // Historique conservé.
        allow delete: if false;

        match /participants/{serverId} {
          allow read: if sameEstablishment(establishmentId) && (
            isShiftManager() ||
            (
              isFloorManager() &&
              get(shiftDoc(establishmentId, shiftId)).data.floorManagerId == request.auth.uid
            ) ||
            (isServeur() && serverId == request.auth.uid)
          );
          allow create, update: if sameEstablishment(establishmentId) &&
            (
              isShiftManager() ||
              (
                isFloorManager() &&
                getAfter(shiftDoc(establishmentId, shiftId)).data.floorManagerId == request.auth.uid
              )
            ) &&
            validParticipant(establishmentId, shiftId, serverId);
          allow delete: if false;
        }
      }

      // Pointeur vers le dernier service OUVERT d'un Floor Manager.
      match /floorManagerCurrentShift/{floorManagerId} {
        allow read: if sameEstablishment(establishmentId) && (
          isShiftManager() || request.auth.uid == floorManagerId
        );
        allow create, update: if sameEstablishment(establishmentId) &&
          (isShiftManager() || (isFloorManager() && floorManagerId == request.auth.uid)) &&
          request.resource.data.keys().hasOnly([
            'floorManagerId', 'openShiftId', 'updatedAt', 'updatedBy'
          ]) &&
          request.resource.data.floorManagerId == floorManagerId &&
          request.resource.data.openShiftId is string &&
          getAfter(shiftDoc(establishmentId, request.resource.data.openShiftId)).data.status == 'open' &&
          getAfter(shiftDoc(establishmentId, request.resource.data.openShiftId)).data.floorManagerId == floorManagerId &&
          (
            resource == null ||
            fmPointerReleased(establishmentId, resource.data.openShiftId, request.resource.data.openShiftId)
          );
        allow delete: if false;
      }

      // Pointeur vers le dernier service OUVERT d'un serveur.
      match /serverCurrentShift/{serverId} {
        // Floor Manager : lit tous les pointeurs serveur de son établissement
        // (aucune donnée sensible) pour vérifier une disponibilité.
        allow read: if sameEstablishment(establishmentId) && (
          isShiftManager() ||
          request.auth.uid == serverId ||
          isFloorManager()
        );
        allow create, update: if sameEstablishment(establishmentId) &&
          (
            isShiftManager() ||
            (isFloorManager() && request.resource.data.floorManagerId == request.auth.uid)
          ) &&
          request.resource.data.keys().hasOnly([
            'serverId', 'openShiftId', 'floorManagerId', 'updatedAt', 'updatedBy'
          ]) &&
          request.resource.data.serverId == serverId &&
          request.resource.data.openShiftId is string &&
          getAfter(shiftDoc(establishmentId, request.resource.data.openShiftId)).data.status == 'open' &&
          getAfter(shiftDoc(establishmentId, request.resource.data.openShiftId)).data.floorManagerId == request.resource.data.floorManagerId &&
          serverId in getAfter(shiftDoc(establishmentId, request.resource.data.openShiftId)).data.serverIds &&
          (
            resource == null ||
            serverPointerReleased(establishmentId, resource.data.openShiftId, request.resource.data.openShiftId, serverId)
          );
        allow delete: if false;
      }

      // PAS de filet de lecture « tout le tenant » ici : les règles Firestore
      // s'additionnent (OU), un tel filet annulerait les restrictions de
      // lecture ci-dessus (comptabilité, hygiène…). Toute sous-collection
      // doit avoir sa propre règle ; sinon le filet final refuse.
    }

    // ─────────────── FILET FINAL : tout le reste refusé ───────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}